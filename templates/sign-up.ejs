<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign up</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: #001e2b;
            color: #00ed64;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        }

        .login-box {
            width: 100%;
            max-width: 380px;
            padding: 36px 32px;
            background: #06293a;
            border: 1px solid #0f4a5f;
            border-radius: 10px;
        }

        .login-box h1 {
            font-size: 26px;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .login-box p {
            font-size: 14px;
            color: #7fb8a0;
            margin-bottom: 28px;
        }

        .field {
            margin-bottom: 18px;
        }

        .field label {
            display: block;
            font-size: 13px;
            margin-bottom: 6px;
            color: #7fb8a0;
        }

        .field input {
            width: 100%;
            padding: 11px 12px;
            font-size: 15px;
            color: #00ed64;
            background: #001e2b;
            border: 1px solid #0f4a5f;
            border-radius: 6px;
        }

        .field input:focus {
            outline: none;
            border-color: #00ed64;
            box-shadow: 0 0 0 3px rgba(0, 237, 100, 0.2);
        }

        .login-btn {
            width: 100%;
            margin-top: 8px;
            padding: 12px;
            font-size: 15px;
            font-weight: 700;
            color: #001e2b;
            background: #00ed64;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }

        .login-btn:hover {
            background: #3df58a;
        }

        .login-btn:focus-visible {
            outline: 2px solid #ffffff;
            outline-offset: 2px;
        }

        .switch {
            margin-top: 20px;
            margin-bottom: 0;
            font-size: 14px;
            text-align: center;
        }

        .switch a {
            color: #00ed64;
        }
    </style>
</head>
<body>
    <form class="login-box" action="/signup" method="post">
        <h1>Create account</h1>
        <p>Choose a username and password.</p>

        <div class="field">
            <label for="username">Username</label>
            <input type="text" id="username" name="username" autocomplete="username" autofocus>
        </div>

        <div class="field">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" autocomplete="new-password">
        </div>

        <button class="login-btn" type="submit">Sign up</button>

        <p class="switch">Already have an account? <a href="/">Sign in</a></p>
    </form>
</body>
</html>